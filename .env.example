CHAT_BASE_URL=https://api.deepseek.com
CHAT_API_KEY=
CHAT_MODEL=deepseek-flash
# 使用控制台提供的北京地域 DashScope 原生地址
EMBEDDING_API_FORMAT=dashscope
EMBEDDING_BASE_URL=https://cn-beijing.maas.qianwenaiapi.com/api/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=qwen3.7-text-embedding-flash
EMBEDDING_BATCH_SIZE=20
SEARCH_PROVIDER=auto
TAVILY_API_KEY=
SMTP_HOST=
SMTP_PORT=465
SMTP_USE_SSL=true
SMTP_STARTTLS=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_ALLOWED_RECIPIENTS=[]
API_PROXY=
REQUEST_TIMEOUT=90
MAX_UPLOAD_MB=20

# 登录安全：仅在后续确定正式 HTTPS 域名时填写，修改后重启后端
AUTH_PUBLIC_ORIGIN=
AUTH_SESSION_HOURS=8
AUTH_IDLE_MINUTES=30
AUTH_ALLOWED_HOSTS=["localhost","127.0.0.1","::1"]
